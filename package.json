{
  "name": "netrasonar",
  "version": "1.0.0",
  "private": true,
  "description": "SagarNetra / NetraSonar Autonomous Undersea Anomaly & Mine Detection System",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "start:frontend": "npm --prefix frontend run dev",
    "stop": "bash ./backend/auditing/scripts/stop.sh",
    "build": "npm --prefix frontend run build",
    "demo:setup": "cd backend && venv/bin/python auditing/seed_all.py",
    "demo:reset": "cd backend && rm -f netrasonar.db && venv/bin/python auditing/seed_all.py",
    "healthcheck": "curl -s -f http://localhost:8000/api/health || exit 1",
    "verify:demo": "npm --prefix frontend run build && npx tsx scripts/verify_demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5"
  }
}
