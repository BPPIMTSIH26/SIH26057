# Python & Environment
__pycache__/
*.py[cod]
*$py.class
venv/
backend/venv/
.venv/
env/
.env
.env.*
!.env.example
*.pyc

# Node & Frontend
node_modules/
dist/
.DS_Store

# Test & Cache Artifacts
.pytest_cache/
backend/.pytest_cache/
test.db
backend/test.db
backend/sonar_x.db
backend/*.png

# SAGAR Storage & Data (never push uploads / processed results)
backend/data/*.db
backend/*.db
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/uploads/processing_results/*

# Datasets - never push raw / processed datasets
HG_DATA/
backend/HG_DATA/
/data/
data/training/
data/validation/
data/raw/
data/processed/

# Model weights & ONNX exports - large binaries, never push
*.pt
*.onnx
backend/models/
backend/drishti_best.onnx
backend/yolov8n.pt

# Large binary test fixtures
backend/tests/fixtures/*.jpg
backend/tests/fixtures/*.png
tests/fixtures/*.jpg
tests/fixtures/*.png

# Shared libraries / compiled extensions
*.so
*.dylib

# Misc
*.log
*.egg-info/
large_files/
*.zip

# Frontend stray backend folder (Vercel/Vite artefact - contains its own node_modules)
frontend/backend/
