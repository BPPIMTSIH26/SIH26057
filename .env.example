# ==============================================================================
# SagarNetra / NetraSonar Deployment Environment Variables
# ==============================================================================

# Application Environment (development / production)
APP_ENV=production

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default; PostgreSQL supported for production)
DATABASE_URL=sqlite:///./data/sonar_x.db
# Example PostgreSQL: postgresql://user:password@localhost:5432/sagarnetra

# Storage Directories
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
REPORT_DIR=./data/reports
MODEL_DIR=./models

# Model Configuration
MODEL_PROVIDER=yolo
MODEL_PATH=./yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# CORS Allowed Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:80"]

# Authentication & Security
JWT_SECRET_KEY=generate_a_secure_32_character_random_string_for_production
RATE_LIMIT_AUTH_PER_MINUTE=20

# SMTP Configuration for Email Verification (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Frontend Environment Variable
VITE_API_URL=http://localhost:8000/api
